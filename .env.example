# Existing LLM_* keys in .env are supported directly.
LLM_API_HOST=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-vision-model
LLM_TIMEOUT_SECONDS=180
# Optional fallback must also support image input.
LLM_API_HOST_BACKUP=
LLM_API_KEY_BACKUP=
LLM_MODEL_BACKUP=

# Enterprise self-built app credentials. Do not use the callback token here.
LARK_APP_ID=
LARK_APP_SECRET=
# International Lark: lark; mainland Feishu: feishu
LARK_DOMAIN=lark
MAX_FILE_MB=25
MAX_PDF_PAGES=20
FILE_RETENTION_HOURS=24
HEALTH_PORT=8765
